# ===== LLM（DashScope 兼容 OpenAI 协议）=====
API_KEY=sk-xxxxxxxxxxxxxxxx
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-plus

# ===== Embedding（阿里云百炼，1024 维）=====
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIM=1024
EMBEDDING_CHUNK_SIZE=10

# ===== 关系数据库 MySQL 8（业务数据，async SQLAlchemy）=====
MYSQL_URL=mysql+aiomysql://legal:legal@mysql:3306/legal

# ===== 智能体记忆库 PostgreSQL 16（LangGraph 长期/短期记忆，psycopg2 同步）=====
DB_URI=postgresql+psycopg2://legal:legal@postgres:5432/legal_memory

# ===== 缓存/会话/限流 Redis =====
REDIS_URL=redis://redis:6379/0

# ===== 向量库 Milvus =====
MILVUS_URI=http://milvus:19530
MILVUS_COLLECTION=legal_knowledge

# ===== 图数据库 Neo4j =====
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=legal123456

# ===== 认证 JWT =====
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 初始管理员（首次启动自动创建）=====
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@legal.local
ADMIN_PASSWORD=admin123456

# ===== CORS =====
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ===== 可观测性 =====
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317